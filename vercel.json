{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/projects/oscillation-analysis/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/projects/oscillation-analysis/signals/:name",
      "destination": "/projects/oscillation-analysis/signals/:name.html"
    },
    {
      "source": "/projects/oscillation-analysis/:name",
      "destination": "/projects/oscillation-analysis/:name.html"
    }
  ]
}
